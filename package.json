{
  "name": "ssr-library",
  "version": "1.1.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:types": "tsc -p tsconfig.json",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs",
    "build": "npm run clean && npm run build:types && npm run build:esm && npm run build:cjs",
    "test": "npm run build && node --test",
    "publish:dry-run": "npm publish --dry-run",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/index.cjs --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=95",
    "test:consumer": "npm run build && node scripts/consumer-check.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "ssr",
    "server-side rendering",
    "typescript",
    "html",
    "components",
    "templating",
    "nodejs",
    "esm",
    "commonjs"
  ],
  "author": "Hanif Bahari",
  "license": "MIT",
  "description": "A dependency-free TypeScript toolkit for safely building and rendering server-side HTML components in Node.js.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanifb1360/ssr-library.git"
  },
  "bugs": {
    "url": "https://github.com/hanifb1360/ssr-library/issues"
  },
  "homepage": "https://github.com/hanifb1360/ssr-library#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
