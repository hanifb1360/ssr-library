{
  "name": "ssr-library",
  "version": "1.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "clean": "rm -rf dist",
    "build": "npm run clean && mkdir dist && cp -r src/* dist/",
    "publish:dry-run": "npm publish --dry-run"
  },
  "keywords": [
    "ssr",
    "server-side rendering",
    "component library",
    "nodejs",
    "html components",
    "server-side components",
    "javascript utilities"
  ],
  "author": "Hanif Bahari",
  "license": "MIT",
  "description": "A lightweight and flexible utility library for building and rendering server-side components in Node.js.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanifbahari/ssr-library"
  },
  "bugs": {
    "url": "https://github.com/hanifbahari/ssr-library/issues"
  },
  "homepage": "https://github.com/hanifbahari/ssr-library#readme",
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
