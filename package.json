{
  "name": "ssr-library",
  "version": "1.1.4",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./types/index.d.ts"
    }
  },
  "directories": {},
  "scripts": {
    "test": "node --test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && mkdir dist && cp -r src/* dist/ && cp -r types dist/",
    "publish:dry-run": "npm publish --dry-run"
  },
  "keywords": [
    "ssr",
    "server-side rendering",
    "component library",
    "nodejs",
    "html components",
    "server-side components",
    "javascript utilities"
  ],
  "author": "Hanif Bahari",
  "license": "MIT",
  "description": "A lightweight and flexible utility library for building and rendering server-side components in Node.js.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanifbahari/ssr-library"
  },
  "bugs": {
    "url": "https://github.com/hanifbahari/ssr-library/issues"
  },
  "homepage": "https://github.com/hanifbahari/ssr-library#readme",
  "dependencies": {
    "express": "^4.21.2"
  }
}
